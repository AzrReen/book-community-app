import 'package:flutter/material.dart';

void main() => runApp(const BiblioApp());

class BiblioApp extends StatelessWidget {
  const BiblioApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        scaffoldBackgroundColor: const Color(0xFFF2F4F5),
      ),
      home: const MainNavigationWrapper(),
    );
  }
}

class CommunityFeedScreen extends StatelessWidget {
  const CommunityFeedScreen({super.key});

  // Color Palette from Design
  final Color primaryTeal = const Color(0xFF537D82);
  final Color statusRed = const Color(0xFF8C4A43);
  final Color interactionTeal = const Color(0xFF42919B);

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: primaryTeal,
        leading: const Icon(Icons.arrow_back, color: Colors.white),
        title: const Text("Community Feed", style: TextStyle(color: Colors.white, fontSize: 18)),
        actions: [
          IconButton(onPressed: () {}, icon: const Icon(Icons.more_vert, color: Colors.white)),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
        children: [
          // 1. Status Update / Currently Reading Post
          _buildStatusPost(),
          
          const SizedBox(height: 12),

          // 2. Book Review Post
          _buildReviewPost(
            userName: "BookReviewPost",
            reviewText: "Just finished 'The Midnight Library'. A mind-bending coffee, cozy blanket, and starting this roads not taken.",
            bookTitle: "The Midnight Library",
            author: "Matt Haig",
            rating: 5,
            likes: 20,
          ),

          const SizedBox(height: 12),

          // 3. Bookstagram Style Photo Post
          _buildReviewPost(
            userName: "BookstagramPost",
            reviewText: "Sunday matlyfey through: The wind incensbel, but it's woidgewihttit body today!",
            bookTitle: "Dune 2",
            author: "Frank Herbert",
            rating: 4,
            likes: 20,
          ),
          
          const SizedBox(height: 12),

          // 4. Simple User Post
          _buildSimpleUserPost("ReokishBob", "required Title Medium"),
        ],
      ),
      //bottomNavigationBar: _buildBottomNav(),
    );
  }

  Widget _buildStatusPost() {
    return Card(
      elevation: 0,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text("BibloiphibeBetty", style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
            const SizedBox(height: 4),
            const Text("Just finished 'The Midnight Library' A mind-bending thaakes all you ponde not taken. Highly recommend!"),
            const SizedBox(height: 12),
            Row(
              children: [
                const Icon(Icons.book, color: Colors.grey, size: 20),
                const SizedBox(width: 8),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  decoration: BoxDecoration(color: interactionTeal, borderRadius: BorderRadius.circular(15)),
                  child: const Text("19", style: TextStyle(color: Colors.white, fontSize: 12)),
                ),
                const Spacer(),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                  decoration: BoxDecoration(color: statusRed, borderRadius: BorderRadius.circular(15)),
                  child: const Text("Currently Reading", style: TextStyle(color: Colors.white, fontSize: 12)),
                ),
              ],
            )
          ],
        ),
      ),
    );
  }

  Widget _buildReviewPost({required String userName, required String reviewText, required String bookTitle, required String author, required int rating, required int likes}) {
    return Card(
      elevation: 0,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(userName, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
            const SizedBox(height: 10),
            Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                ClipRRect(
                  borderRadius: BorderRadius.circular(4),
                  child: Container(color: Colors.grey[300], width: 60, height: 90, child: const Icon(Icons.book)),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(reviewText, style: const TextStyle(fontSize: 13), maxLines: 3, overflow: TextOverflow.ellipsis),
                      const SizedBox(height: 8),
                      Text("Book Title: $bookTitle", style: const TextStyle(fontSize: 12, color: Colors.grey)),
                      Text("Author: $author", style: const TextStyle(fontSize: 12, color: Colors.grey)),
                      const SizedBox(height: 4),
                      _buildStars(rating),
                      const SizedBox(height: 2),
                      Row(
                        mainAxisAlignment: MainAxisAlignment.end,
                        children: [
                          _buildStars(5), // Secondary interaction/rating
                          const SizedBox(width: 8),
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                            decoration: BoxDecoration(color: interactionTeal, borderRadius: BorderRadius.circular(12)),
                            child: Text("$likes", style: const TextStyle(color: Colors.white, fontSize: 11)),
                          ),
                        ],
                      ),
                    ],
                  ),
                )
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildStars(int count) {
    return Row(
      children: List.generate(5, (index) => Icon(
        Icons.star, 
        size: 14, 
        color: index < count ? Colors.orange : Colors.grey[300]
      )),
    );
  }

  Widget _buildSimpleUserPost(String name, String sub) {
    return Card(
      elevation: 0,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: ListTile(
        leading: const CircleAvatar(backgroundColor: Colors.grey, child: Icon(Icons.person, color: Colors.white)),
        title: Text(name, style: const TextStyle(fontWeight: FontWeight.bold)),
        subtitle: Text(sub),
      ),
    );
  }
}

// --- NAVIGATION WRAPPER ---
class MainNavigationWrapper extends StatefulWidget {
  const MainNavigationWrapper({super.key});

  @override
  State<MainNavigationWrapper> createState() => _MainNavigationWrapperState();
}

class _MainNavigationWrapperState extends State<MainNavigationWrapper> {
  int _selectedIndex = 2; // Default to Community

  // Pages to switch between
  final List<Widget> _pages = [
    const Center(child: Text("Shop")),
    const Center(child: Text("Library")),
    const CommunityFeedScreen(),
    const ChatListScreen(), 
    const Center(child: Text("Profile")),
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: _pages[_selectedIndex],
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _selectedIndex,
        onTap: (index) => setState(() => _selectedIndex = index),
        type: BottomNavigationBarType.fixed,
        selectedItemColor: const Color(0xFF537D82),
        unselectedItemColor: Colors.grey,
        items: const [
          BottomNavigationBarItem(icon: Icon(Icons.shopping_basket_outlined), label: "Shop"),
          BottomNavigationBarItem(icon: Icon(Icons.menu_book), label: "Library"),
          BottomNavigationBarItem(icon: Icon(Icons.chat_bubble), label: "Community"),
          BottomNavigationBarItem(icon: Icon(Icons.forum_outlined), label: "Chat"),
          BottomNavigationBarItem(icon: Icon(Icons.person_outline), label: "Profile"),
        ],
      ),
    );
  }
}

// --- CHAT LIST SCREEN (chat) ---
class ChatListScreen extends StatelessWidget {
  const ChatListScreen({super.key});

  final Color primaryTeal = const Color(0xFF537D82);

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: primaryTeal,
        title: const Text("Messages", style: TextStyle(color: Colors.white)),
        actions: [IconButton(onPressed: () {}, icon: const Icon(Icons.edit_note, color: Colors.white))],
      ),
      body: Column(
        children: [
          // Search Bar
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: TextField(
              decoration: InputDecoration(
                hintText: "Search chats...",
                prefixIcon: const Icon(Icons.search),
                filled: true,
                fillColor: Colors.white,
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(30), borderSide: BorderSide.none),
              ),
            ),
          ),
          // Chat List
          Expanded(
            child: ListView(
              children: [
                _buildChatTile("BibloiphibeBetty", "Loved your review on The Midnight Library!", "2m ago", true),
                _buildChatTile("ReokishBob", "Do you have the physical copy of Dune?", "1h ago", false),
                _buildChatTile("ReokishRita", "Sent a photo", "Yesterday", false),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildChatTile(String name, String message, String time, bool isUnread) {
    return ListTile(
      leading: const CircleAvatar(backgroundColor: Colors.grey, radius: 25, child: Icon(Icons.person, color: Colors.white)),
      title: Text(name, style: TextStyle(fontWeight: isUnread ? FontWeight.bold : FontWeight.normal)),
      subtitle: Text(message, maxLines: 1, overflow: TextOverflow.ellipsis),
      trailing: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Text(time, style: const TextStyle(fontSize: 12, color: Colors.grey)),
          if (isUnread) const Padding(padding: EdgeInsets.only(top: 4), child: CircleAvatar(radius: 4, backgroundColor: Color(0xFF8C4A43))),
        ],
      ),
      onTap: () {
        // Navigate to actual chat room logic here
      },
    );
  }
}

